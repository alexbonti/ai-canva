rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
      // TEMPORARY: allow any authenticated user to read/update for debugging
      allow read, update: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /presence/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // User profiles — each user manages their own doc (used for admin stats).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Custom box templates — reusable AI box definitions saved per user.
      // (The doc rule above does not cover subcollections, hence this block.)
      match /boxes/{boxId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Admin designation — a user can read their own admin doc to check status.
    // Actual stats are served by the admin Cloud Function (Admin SDK), which
    // bypasses these rules, so no broad read access is granted here.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Token usage — a user can only create/read their own call records.
    // Per-user rolling totals use Firestore increment, which is a write to
    // the user's own doc.
    match /tokenUsage/{id} {
      allow read: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /usageTotals/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Async Stitch UI jobs — accessed only server-side through the Admin SDK
    // via POST /api/stitch-generate and GET /api/stitch-status/:id. Clients
    // must never read/write these docs directly.
    match /stitchJobs/{jobId} {
      allow read, write: if false;
    }
  }
}
