# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Server port
PORT=3001

# Anthropic model (optional — defaults to claude-sonnet-5)
# Other options: claude-opus-5, claude-haiku-5
# ANTHROPIC_MODEL=claude-sonnet-5

# fal.ai API key — get yours at https://fal.ai/dashboard/keys
# Used for image generation (cartoon profile pictures, etc.)
FAL_KEY=your-fal-key-here
